<Window x:Class="NobreakMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NobreakMonitor.App.ViewModels"
        Title="Nobreak Monitor" Height="620" Width="760" MinHeight="520" MinWidth="640"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen"
        Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="BorderBrush" Value="#E0E3E8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel d:DataContext="{d:DesignInstance vm:MainViewModel}"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d">

        <!-- Cabeçalho -->
        <Border DockPanel.Dock="Top" Background="{Binding HeadlineBrush}" Padding="18,12">
            <StackPanel>
                <TextBlock Text="{Binding Headline}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SubHeadline}" Foreground="White" Opacity="0.9" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Contagem de desligamento -->
        <Border DockPanel.Dock="Top" Background="#B71C1C" Padding="18,10"
                Visibility="{Binding CountdownActive, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancelar desligamento" Margin="0"
                        Command="{Binding CancelComputerShutdown}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CountdownText}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Rodapé -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E3E8" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceInfo}" Foreground="#6B7280" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#374151" />
            </DockPanel>
        </Border>

        <TabControl Margin="8" Padding="6">
            <!-- Painel -->
            <TabItem Header="Painel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Tensão de entrada" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding InputVoltage}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Tensão de saída" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding OutputVoltage}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Carga" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding Load}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Frequência" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding Frequency}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Tensão da bateria" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding BatteryVoltage}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Temperatura" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding Temperature}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Carga estimada da bateria" Style="{StaticResource CardLabel}" />
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold"
                                               Text="{Binding BatteryPercent, StringFormat={}{0}%}" />
                                </DockPanel>
                                <ProgressBar Value="{Binding BatteryPercent, Mode=OneWay}" Maximum="100" Height="14" Margin="0,6,0,2" />
                                <TextBlock Text="Estimativa pela tensão (mesma tabela do TSApp); varia com a carga."
                                           Style="{StaticResource CardLabel}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <TextBlock Text="{Binding Flags}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Comandos -->
            <TabItem Header="Testes e comandos">
                <StackPanel Margin="10">
                    <TextBlock Text="Testes de bateria" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="Teste de 10 segundos" Command="{Binding Test10Seconds}" />
                        <Button Content="Teste até bateria baixa" Command="{Binding TestUntilLow}" />
                        <Button Content="Cancelar teste" Command="{Binding CancelTest}" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Testar por" VerticalAlignment="Center" Margin="0,0,6,8" />
                        <TextBox Width="50" Text="{Binding TestMinutesValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,8" />
                        <TextBlock Text="minuto(s)" VerticalAlignment="Center" Margin="0,0,10,8" />
                        <Button Content="Iniciar" Command="{Binding TestMinutes}" />
                    </StackPanel>
                    <TextBlock Text="Durante os testes o desligamento automático do computador é ignorado."
                               Foreground="#6B7280" Margin="0,0,0,16" />

                    <TextBlock Text="Nobreak" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="Ligar/desligar beep" Command="{Binding ToggleBeep}" />
                        <Button Content="Cancelar desligamento do nobreak" Command="{Binding CancelUpsShutdown}" />
                        <Button Content="Procurar nobreak novamente" Command="{Binding Rescan}" />
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <!-- Configurações -->
            <TabItem Header="Configurações">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Desligamento do computador" FontWeight="SemiBold" />

                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Desligar quando o nobreak entrar na bateria, após" IsChecked="{Binding ShutdownOnBattery}" />
                            <TextBox Width="70" Margin="6,0" Text="{Binding OnBatteryDelaySeconds}" IsEnabled="{Binding ShutdownOnBattery}" />
                            <TextBlock Text="segundos" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Desligar ao sinalizar bateria baixa, após" IsChecked="{Binding ShutdownOnLowBattery}" />
                            <TextBox Width="70" Margin="6,0" Text="{Binding LowBatteryDelaySeconds}" IsEnabled="{Binding ShutdownOnLowBattery}" />
                            <TextBlock Text="segundos (encurta a contagem em curso)" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Fechar programas à força (evita que um &quot;Deseja salvar?&quot; trave o desligamento)"
                                  IsChecked="{Binding ForceCloseApps}" />

                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Desligar a saída do nobreak" VerticalAlignment="Center" />
                            <TextBox Width="60" Margin="6,0" Text="{Binding UpsOffAfterShutdownMinutes}" />
                            <TextBlock Text="min após desligar o PC (0 = não; 0,2 a 10)" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Modo simulação (registra no histórico, mas não desliga)" IsChecked="{Binding SimulateShutdown}" />

                        <TextBlock Text="Comunicação" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Porta COM" VerticalAlignment="Center" Width="140" />
                            <TextBox Width="90" Text="{Binding PortName}" />
                            <TextBlock Text="vazio = detectar automaticamente" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Intervalo de leitura (ms)" VerticalAlignment="Center" Width="140" />
                            <TextBox Width="90" Text="{Binding PollIntervalMs}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Salvar" Command="{Binding SaveConfig}" FontWeight="SemiBold" />
                            <Button Content="Descartar alterações" Command="{Binding ReloadConfig}" />
                        </StackPanel>

                        <TextBlock Text="Este aplicativo" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <CheckBox Content="Abrir este painel (na bandeja) ao entrar no Windows" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="O monitoramento e o desligamento são feitos pelo serviço do Windows, mesmo com este painel fechado ou sem ninguém logado." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Histórico -->
            <TabItem Header="Histórico">
                <DockPanel>
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Atualizar" Command="{Binding RefreshEvents}" Margin="4" />
                    <ListView ItemsSource="{Binding Events}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Data/hora" Width="150" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="Evento" Width="520">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
